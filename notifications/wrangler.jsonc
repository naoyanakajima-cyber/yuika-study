{
  "name": "yuika-challenge-reports",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "durable_objects": {"bindings": [{"name": "REPORTS", "class_name": "ReportDelivery"}]},
