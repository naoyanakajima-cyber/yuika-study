+<script>
+'use strict';
+const UNIT = '通過算・旅人算　進む長さをつかむ';
+const STAGES = ['何m進むか', '速さの和か差か', '単位をそろえる', '通過算を通しで解く', '旅人算'];
+const QUESTIONS = JSON.parse(document.getElementById('questions').textContent);
+const main = document.getElementById('main');
+const back = document.getElementById('back');
+const esc = value => String(value).replace(/[&<>"']/g, char => (
+  {'&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;'}[char]
+));
+let run = null;
+
+function button(id, action) {
+  document.getElementById(id).onclick = action;
+}
+
+function focusMain() {
+  main.focus();
+  window.scrollTo(0, 0);
+}
+
+function home() {
+  run = null;
+  main.innerHTML = `<section class="unit-hero card"><h1>${UNIT}</h1>
+    <p>進む長さ、速さ、単位を順に練習して、通過算と旅人算を解こう。</p></section>
+    <section class="card"><h2>段階を選ぶ</h2><div class="stage-list">
+    ${STAGES.map((label, step) => `<button data-stage="${step}">S${step + 1}　${label}（${QUESTIONS.filter(q => q.step === step).length}問）</button>`).join('')}
+    </div></section>`;
+  main.querySelectorAll('[data-stage]').forEach(control => {
+    control.onclick = () => start(Number(control.dataset.stage));
+  });
+  focusMain();
+}
+
+function start(step) {
+  run = {step, id: window.YuikaReports.id(), questions: QUESTIONS.filter(q => q.step === step), answers: [], finished: false};
+  quiz();
+}
+
+function stageLabel() {
+  return `S${run.step + 1} ${STAGES[run.step]}`;
+}
+
+function quiz() {
+  const q = run.questions[run.answers.length];
+  const numeric = q.type === 'number';
+  let selection = null;
+  let hintUsed = false;
+  const index = run.answers.length;
+  main.innerHTML = `<section class="quiz card">
+    <p class="muted">${stageLabel()} · ${index + 1} / ${run.questions.length}問</p>
+    <h1 class="question">${esc(q.prompt)}</h1>
+    ${numeric ? `<label for="numeric">答え（数字だけ）</label>
+      <div><input id="numeric" inputmode="decimal" autocomplete="off" maxlength="60" aria-describedby="answer-unit"> <b id="answer-unit">${esc(q.answerUnit)}</b></div>`
+      : `<div class="choices">${q.options.map((option, i) => `<button class="option" data-choice="${i}" aria-pressed="false">${esc(option)}</button>`).join('')}</div>`}
+    <div id="error" role="alert"></div>
+    <div class="actions"><button class="primary" id="check">答え合わせ</button><button id="hint">ヒントを見る</button></div>
+    <p id="hintbox" class="note" hidden></p>
+    <div id="feedback" aria-live="polite"></div>
+    <div class="actions"><button id="end">今日はここまで</button></div>
+    </section>`;
+
+  const input = document.getElementById('numeric');
+  const check = document.getElementById('check');
+  const choices = main.querySelectorAll('[data-choice]');
+  choices.forEach(control => {
+    control.onclick = () => {
+      selection = q.options[Number(control.dataset.choice)];
+      choices.forEach(choice => choice.setAttribute('aria-pressed', choice === control));
+    };
+  });
+  button('hint', () => {
+    hintUsed = true;
+    const hint = document.getElementById('hintbox');
+    hint.textContent = q.hint;
+    hint.hidden = false;
+    document.getElementById('hint').disabled = true;
+  });
+  button('check', () => {
+    if (check.disabled) return;
+    // Match the science engine's decimal input convention, including full-width digits.
+    const raw = numeric ? input.value.normalize('NFKC').trim() : selection;
+    const value = numeric && /^(?:\d+(?:\.\d*)?|\.\d+)$/.test(raw) ? Number(raw) : raw;
+    if (numeric ? typeof value !== 'number' || !Number.isFinite(value) : value === null) {
+      document.getElementById('error').textContent = numeric ? '0以上の数字を入力してね。' : '答えをひとつ選んでね。';
+      return;
+    }
+    document.getElementById('error').textContent = '';
+    const correct = value === q.answer;
+    const tag = correct ? '' : numeric ? q.wrongValues[value] ?? '計算・立式を見直す' : q.optionTags[value];
+    const unit = q.answerUnit || '';
+    const decimalHint = numeric && unit === 'm' && !Number.isInteger(value)
+      ? '長さが小数になったら見直そう。' : '';
+    const explanation = [q.explanation, !correct && q.pitfall, tag && `誤答タグ：${tag}`, decimalHint].filter(Boolean).join(' ');
+    run.answers.push({question: q.prompt, response: value + unit, expected: q.answer + unit,
+      explanation, correct, hint: hintUsed, mode: stageLabel()});
+    main.querySelectorAll('[data-choice],#numeric,#hint,#check').forEach(control => control.disabled = true);
+    const complete = run.answers.length === run.questions.length;
+    if (complete) report(false);
+    document.getElementById('feedback').innerHTML = `<div class="note">
+      <h2>${correct ? 'できたね！' : '考え方を確認しよう'}</h2>
+      <p>あなたの答え：<b>${esc(value)}${unit}</b><br>正しい答え：<b>${esc(q.answer)}${unit}</b></p>
+      <ol>${q.steps.map(step => `<li>${esc(step)}</li>`).join('')}</ol>
+      ${correct ? '' : `<p>${esc(q.pitfall)} ${esc(decimalHint)}</p><p>誤答タグ：${esc(tag)}</p>`}
+      </div><button class="primary" id="next">${complete ? '今回のふりかえり' : '次の問題へ'}</button>`;
+    button('next', complete ? result : quiz);
+    document.getElementById('next').focus();
+  });
+  if (input) input.onkeydown = event => {
+    if (event.key === 'Enter' && !event.isComposing) check.click();
+  };
+  button('end', () => {
+    if (run.answers.length) result();
+    else home();
+  });
+  focusMain();
+}
+
+function report(partial) {
+  if (run.finished) return;
+  run.finished = true;
+  if (window.YuikaParent.suppress()) return;
+  const answers = run.answers;
+  window.YuikaReports.enqueue({
+    version: 1, id: 'math-passage:' + run.id, app: 'legacy', subject: '算数', unit: UNIT,
+    mode: stageLabel() + (partial ? '（途中終了）' : ''), completedAt: new Date().toISOString(),
+    total: answers.length, correct: answers.filter(a => a.correct).length, detail: 'full', answers
+  });
+}
+
+function result() {
+  const partial = run.answers.length < run.questions.length;
+  report(partial);
+  main.innerHTML = `<section class="card"><h1>今回のふりかえり</h1>
+    <p>${stageLabel()}${partial ? '（途中終了）' : ''}</p>
+    <p><strong>${run.answers.filter(a => a.correct).length} / ${run.answers.length}問 正解</strong></p>
+    <div class="actions"><button id="return">段階を選ぶ</button>
+    ${!partial && run.step + 1 < STAGES.length ? '<button class="primary" id="next-stage">次の段階へ</button>' : ''}</div></section>`;
+  button('return', home);
+  if (document.getElementById('next-stage')) button('next-stage', () => start(run.step + 1));
+  focusMain();
+}
+
+button('back', () => {
+  if (run && !run.finished && run.answers.length) {
+    result();
+    return;
+  }
+  window.YuikaParent.navigate('index.html');
+});
+back.insertAdjacentHTML('afterbegin', window.YuikaDesign.icon('back'));
+home();
+</script>
+</body>
+</html>
